# Copy this file to .env.local (which is gitignored — never commit real
# credentials) and fill in your own values to enable "List for sale" on
# the Collection page (see lib/shopify.js for the one-time Shopify setup
# steps and exactly which Admin API scopes are needed).

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_token_here
